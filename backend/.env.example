# Copy to .env and fill in. The real .env is git-ignored.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---- Oracle (local: Docker container 'vihan-oracle', see README) ----
DB_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
DB_USER=VIHAN_APP
DB_PASSWORD=change_me

# ---- Oracle (cloud: Autonomous DB) - fill in at M10 ----
# DB_URL=jdbc:oracle:thin:@vihandb_tp?TNS_ADMIN=/opt/vihan/wallet
#   or TLS without wallet:
# DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=<HOSTNAME>))(connect_data=(service_name=<SERVICE>_tp.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
# DB_WALLET_PASSWORD=

# ---- Security ----
JWT_SECRET=<64+ random chars>
AADHAAR_ENC_KEY=<base64 32-byte key>
AADHAAR_HASH_KEY=<base64 32-byte key>
BOOTSTRAP_ADMIN_PASSWORD=<first-run only>
# Local only: password for the sample staff logins
DEV_SAMPLE_PASSWORD=<any>
# Local: Cloudflare test key 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=<from Cloudflare>
# Optional: only accept captchas solved on this host (production domain). Blank = no check.
TURNSTILE_HOSTNAME=
# Offline development only: skip the captcha check entirely. Never false in the cloud.
CAPTCHA_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Files ----
UPLOAD_DIR=./uploads
PUBLIC_FILE_BASE_URL=/files
